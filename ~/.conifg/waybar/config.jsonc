{
    "layer": "top",
    "position": "top",
    "height": 24,

    "modules-left": [mango/workspaces", "mango/layout", "mango/window],
    "modules-center": [],

    "modules-right": [
        "temperature",
        "clock"
    ],

    "temperature": {
        "thermal-zone": 0,
        "format": " {temperatureC}°"
    },

    "clock": {
        "format": "{:%H:%M}"
    }
}
