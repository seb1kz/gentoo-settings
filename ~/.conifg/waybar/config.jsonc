{
    "layer": "top",
    "position": "top",
    "height": 26,

    "modules-left": ["ext/workspaces", "mango/layout", "mango/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "temperature",
        "memory"
    ],

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "tooltip-format": "Użycie RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    }
}
