{
    "layer": "top",
    "position": "top",
    "height": 24,

    "modules-left": ["ext/workspaces", "mango/layout", "mango/window"],
    "modules-center": [],
    "modules-right": [
        "temperature",
        "clock"
    ],

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "clock": {
        "format": "{:%H:%M}"
    }
}
