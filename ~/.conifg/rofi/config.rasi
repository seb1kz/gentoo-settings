configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";
    kb-move-char-forward: "Right";
    kb-move-char-back: "Left";
    kb-mode-next: "Alt+Right";
    window-format: "{n} {t}";
    kb-mode-previous: "Alt+Left";
    drun-display-format: "{name}";
    fixed-height: true;
}

@theme "storm"

/* ── Palette (Niebieska wersja) ───────────────────────────────────────── */
* {
    bg0:     #131620;   /* Głębokie niebiesko-ciemne tło */
    bg1:     #1c2233;   /* Tło elementu */
    bg2:     #27324d;   /* Podświetlenie / tło akcentu */
    bg3:     #3b4d75;   /* Ciemny niebieski / selection active */
    fg0:     #cbe0ff;   /* Główny jasny niebiesko-biały tekst */
    fg1:     #8ab4f8;   /* Zaznaczony tekst (niebieski akcent) */
    fg2:     #6c8ebf;   /* Przygaszony niebieski tekst */
    red:     #ff757f;
    green:   #c3e88d;
    yellow:  #ffc777;
    blue:    #82aaff;
    magenta: #82aaff;   /* Zamieniono fiolet na błękit */
    cyan:    #86e1fc;
    purple:  #89b4fa;   /* Zamieniono fiolet na błękit */

    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}

/* ── Window ───────────────────────────────────────────────────────────── */
window {
    width:              500px;
    background-color: @bg0;
    border:             1px;
    border-color:       @fg2;
    border-radius:      0px;
    padding:            0;
}

listbox {
    padding:            12px;
    spacing:            0;
    background-color: transparent;
    children:           [ listview ];
}

/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:           [ inputbar, message, listview ];
    spacing:            0;
    padding:            12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @bg0;
    padding:            1px 10px;
    margin:             0 0 10px 0;
    children:           [ prompt, entry ];
    spacing:            6px;
}

prompt {
    background-color: transparent;
    text-color:         @accent;
    font:               "ComicShannsMono Nerd Font 12";
}

entry {
    background-color: transparent;
    text-color:         @fg0;
    placeholder:        "";
    placeholder-color: @fg2;
    font:               "ComicShannsMono Nerd Font 12";
    cursor:             text;
}

button {
    background-color: @bg2;
    text-color:         @fg0;
    border-radius:      1px;
    cursor:             pointer;
}

button selected {
    background-color: @accent;
    text-color:         @bg0;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:            1;
    lines:              5;
    spacing:            4px;
    fixed-height:       false;
}

scrollbar {
    width:              4px;
    handle-width:       4px;
    background-color: @bg2;
    handle-color:       @accent;
    border-radius:      0px;
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:         @fg0;
    border-radius:      0px;
    padding:            8px 10px;
    spacing:            8px;
    orientation:        horizontal;
    cursor:             pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:         @fg0;
}

element normal.urgent {
    background-color: transparent;
    text-color:         @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:         @cyan;
}

element selected.normal {
    background-color: @fg1;
    text-color:         @bg0;
    border-color:       @accent;
}

element selected.urgent {
    background-color: @bg3;
    text-color:         @urgent;
    border-color:       @urgent;
}

element selected.active {
    background-color: @bg3;
    text-color:         @cyan;
    border-color:       @cyan;
}

element-icon {
    background-color: transparent;
    size:               24px;
    cursor:             inherit;
}

element-text {
    background-color: transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    font:               "ComicShannsMono Nerd Font 12";
}

/* ── Message ──────────────────────────────────────────────────────────── */
message {
    background-color: @bg2;
    border-radius:      0px;
    padding:            8px 12px;
    margin:             0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:         @fg2;
    font:               "ComicShannsMono Nerd Font 12";
}
