configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";
    kb-move-char-forward: "Right";
    kb-move-char-back: "Left";
    kb-mode-next: "Alt+Right";
    window-format: "{n} {t}";
    kb-mode-previous: "Alt+Left";
    drun-display-format: "{name}";
    fixed-height: true;
}

@theme "storm"

/* ── Palette (Dracula Theme) ───────────────────────────────────────────── */
* {
    bg0:       #282a36;   /* Dracula Background */
    bg1:       #383a59;   /* Tło elementu */
    bg2:       #44475a;   /* Dracula Selection / tło akcentu */
    bg3:       #6272a4;   /* Dracula Comment / active selection */
    fg0:       #f8f8f2;   /* Dracula Foreground (główny jasny tekst) */
    fg1:       #50fa7b;   /* Zaznaczony tekst (Dracula Green) */
    fg2:       #6272a4;   /* Przygaszony tekst */
    red:       #ff5555;
    green:     #50fa7b;
    yellow:    #f1fa8c;
    blue:      #8be9fd;
    magenta:   #ff79c6;
    cyan:      #8be9fd;
    purple:    #bd93f9;   /* Dracula Purple */

    accent:    @purple;
    urgent:    @yellow;

    background-color: transparent;
    text-color:       @fg0;
}

/* ── Window ───────────────────────────────────────────────────────────── */
window {
    width:              500px;
    background-color: @bg0;
    border:             1px;
    border-color:       @fg2;
    border-radius:      0px;
    padding:            0;
}

listbox {
    padding:            12px;
    spacing:            0;
    background-color: transparent;
    children:           [ listview ];
}

/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:           [ inputbar, message, listview ];
    spacing:            0;
    padding:            12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @bg0;
    padding:            1px 10px;
    margin:             0 0 10px 0;
    children:           [ prompt, entry ];
    spacing:            6px;
}

prompt {
    background-color: transparent;
    text-color:         @accent;
    font:               "ComicShannsMono Nerd Font 12";
}

entry {
    background-color: transparent;
    text-color:         @fg0;
    placeholder:        "";
    placeholder-color: @fg2;
    font:               "ComicShannsMono Nerd Font 12";
    cursor:             text;
}

button {
    background-color: @bg2;
    text-color:         @fg0;
    border-radius:      1px;
    cursor:             pointer;
}

button selected {
    background-color: @accent;
    text-color:         @bg0;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:            1;
    lines:              5;
    spacing:            4px;
    fixed-height:       false;
}

scrollbar {
    width:              4px;
    handle-width:       4px;
    background-color: @bg2;
    handle-color:       @accent;
    border-radius:      0px;
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:         @fg0;
    border-radius:      0px;
    padding:            8px 10px;
    spacing:            8px;
    orientation:        horizontal;
    cursor:             pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:         @fg0;
}

element normal.urgent {
    background-color: transparent;
    text-color:         @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:         @cyan;
}

element selected.normal {
    background-color: @bg2;
    text-color:         @fg1;
    border-color:       @accent;
}

element selected.urgent {
    background-color: @bg3;
    text-color:         @urgent;
    border-color:       @urgent;
}

element selected.active {
    background-color: @bg3;
    text-color:         @cyan;
    border-color:       @cyan;
}

element-icon {
    background-color: transparent;
    size:               24px;
    cursor:             inherit;
}

element-text {
    background-color: transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    font:               "ComicShannsMono Nerd Font 12";
}

/* ── Message ──────────────────────────────────────────────────────────── */
message {
    background-color: @bg2;
    border-radius:      0px;
    padding:            8px 12px;
    margin:             0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:         @fg2;
    font:               "ComicShannsMono Nerd Font 12";
}
